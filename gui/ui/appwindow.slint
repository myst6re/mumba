import { Button, ComboBox, StyleMetrics, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { SetupPage } from "pages/setup.slint";
import { OptionsPage } from "pages/options.slint";
import { SelectDirPage } from "pages/select_dir.slint";
import { InstallDiscsPage } from "pages/install_discs.slint";
import { HomePage } from "pages/home.slint";
import { Installations, Fluent, Page } from "global.slint";

export { Installations, Fluent }

export component AppWindow inherits Window {
    preferred-width: 640px;
    preferred-height: 480px;
    title: Fluent.get-message("window-title");
    icon: @image-url("../data/icon.png");

    if Installations.current-page == Page.home : HomePage {}
    if Installations.current-page == Page.setup : SetupPage {}
    if Installations.current-page == Page.options : OptionsPage {}
    if Installations.current-page == Page.select-dir : SelectDirPage {}
    if Installations.current-page == Page.install-discs : InstallDiscsPage {}
}
